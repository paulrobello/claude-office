{
  "name": "opencode-claude-office",
  "version": "0.25.0",
  "description": "OpenCode plugin that sends lifecycle events to Claude Office Visualizer",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "opencode",
    "claude-office",
    "visualizer",
    "plugin",
    "ai",
    "agent"
  ],
  "license": "MIT",
  "//": [
    "`typescript` held at ^6.0.3 (latest 6.x): typescript-eslint has no TS 7",
    "support yet (peer range <6.1.0; TS >=7.1 tracked in typescript-eslint",
    "issue #10940). Lint crashes on TS 7.0. Re-evaluate on the next",
    "typescript-eslint upgrade."
  ],
  "dependencies": {
    "@opencode-ai/plugin": "1.19.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
