{
  "name": "frontend",
  "version": "0.25.0",
  "//": [
    "Dependency policy (ARC-027, 2026-07): runtime `dependencies` are exact-pinned",
    "for reproducible builds; `devDependencies` use caret ranges so build tools",
    "float within minor.",
    "`overrides`: all @typescript-eslint/* sub-packages pinned to 8.72.1 to match",
    "the typescript-eslint umbrella (8.72.1, verified 2026-11-05). eslint-config-next",
    "16.4.5 peers eslint >=9.0.0 / typescript >=3.3.1 and places no umbrella-version",
    "constraint; without these pins, transitive resolution can mix 8.4x-era",
    "sub-packages with the umbrella and crash lint rules. Re-evaluate on",
    "the next eslint-config-next upgrade.",
    "`typescript` held at ^6.0.3 (latest 6.x): typescript-eslint 8.72.1 has no TS 7",
    "support yet (peer >=4.8.4 <6.1.0, verified 2026-11-05; latest TS is 7.0.2).",
    "`eslint` held at ^9.39.5 (latest 9.x): eslint-plugin-react 7.37.5 (declared",
    "by eslint-config-next) peers up to ^9.7 only and crashes on eslint 10",
    "(latest 10.14.0, verified 2026-11-05)."
  ],
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@pixi/react": "8.0.5",
    "@xstate/react": "6.1.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "pixi.js": "8.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-zoom-pan-pinch": "4.2.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "xstate": "5.33.3",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "typescript-eslint": "8.72.1",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript-eslint/utils": "8.72.1",
    "@typescript-eslint/types": "8.72.1",
    "@typescript-eslint/typescript-estree": "8.72.1",
    "@typescript-eslint/scope-manager": "8.72.1",
    "@typescript-eslint/visitor-keys": "8.72.1",
    "@typescript-eslint/type-utils": "8.72.1",
    "@typescript-eslint/project-service": "8.72.1",
    "@typescript-eslint/tsconfig-utils": "8.72.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
